# Free key from https://aistudio.google.com — no credit card needed.
# Copy this file to .env and paste the key. Without it the app still works,
# just without macro estimates and the "generate something new" feature.
GEMINI_API_KEY=

# Optional overrides. Each model has its own free-tier allowance, so when the
# main one runs out for the day the app automatically continues on the fallback.
# FOODIFY_MODEL=gemini-3.6-flash
# FOODIFY_FALLBACK_MODELS=gemini-3.5-flash-lite
